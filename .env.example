# Copy to .env and fill in. .env is git-ignored; never commit it.
# Full instructions: README.md -> "Live mode: get the cookie and CSRF token"

# --- Live mode (optional) ---
# From a SECONDARY Microsoft account that is a Member of the Clarity project.
# Wrap values in single quotes: the cookie contains ; and = characters.
CLARITY_COOKIE='paste-the-cookie-header-value-here'
CLARITY_CSRF_TOKEN='paste-the-csrf-token-header-value-here'

# --- Optional ---
# Your project ID (from the Clarity URL: /projects/view/<id>/dashboard)
# CLARITY_DEFAULT_PROJECT=your-project-id

# Where the Chrome extension saves downloads
# CLARITY_EXPORT_DIR=~/Downloads/clarity-exports

# Request spacing for live mode, in ms (never below 1000)
# CLARITY_MIN_INTERVAL_MS=1200

# Alternative to the two variables above: path to a saved "Copy as cURL (bash)"
# CLARITY_CURL_FILE=.clarity-session
